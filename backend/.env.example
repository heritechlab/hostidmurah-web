# App
FRONTEND_URL=https://hostidmurah.web.id
CORS_ORIGINS=https://hostidmurah.web.id
REFERRAL_BONUS_AMOUNT=10000

# Tripay
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
