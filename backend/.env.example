# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/hostidmurah

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-another-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
